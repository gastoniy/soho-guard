# /etc/systemd/system/zeek.service  (sudo systemctl daemon-reload && sudo systemctl enable zeek)
# Cron "*/5 * * * * root /opt/zeek/bin/zeekctl cron" zostaje (restart po awarii).
[Unit]
Description=Zeek (zeekctl) na eth1
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/zeek/bin/zeekctl deploy
ExecStop=/opt/zeek/bin/zeekctl stop

[Install]
WantedBy=multi-user.target
